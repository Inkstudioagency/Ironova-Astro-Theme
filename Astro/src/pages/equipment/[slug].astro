---
/** CMS template page: one page per Strapi `equipment` entry. */
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaSection from "../../components/CtaSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byOrder, equipmentUrl, getEquipment, img, richText } from "../../lib/strapi";

export async function getStaticPaths() {
  const entries = await getEquipment();
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

// Resolve the entry at render time (not via getStaticPaths props) so content
// edits made in Strapi show up immediately while running `astro dev`.
const entry = (await getEquipment()).find((e) => e.slug === Astro.params.slug);
if (!entry) return Astro.redirect("/404");

const equipment = await getEquipment();
const list0 = byOrder(equipment, "desc").filter((e) => e.slug !== entry.slug).slice(0, 2);
