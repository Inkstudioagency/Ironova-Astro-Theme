              <h2 heading-rebuild="" data-wf-target="[[[&quot;6b03d34cb4fd67e674c02071&quot;,&quot;9b355137-675b-a6d8-342b-2c4fbe591c1d&quot;],[]]]" class="section-heading is-large">Explore Equipment for Your Application</h2>
            </div>
            <div class="equipment-collection w-dyn-list">
              {list0.length > 0 ? (
                <div role="list" class="equipment-list w-dyn-items">
                {list0.map((item) => (
                  <div role="listitem" class="w-dyn-item">
                  <div to-top-2="" class="equipment-item-card">
                    <a href={equipmentUrl(item)} class="equipment-card-image w-inline-block"><img {...img(item.mainImage, "", item.name)} loading="lazy" width="1950" height="1539" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(item.mainImage) }]}>
                      <div class="demo">#</div>
                    </a>
                    <div class="equipment-card-body">
                      <div class="equipment-card-title-link">
                        <div class:list={["font-medium", { "w-dyn-bind-empty": !(item.name) }]}>{item.name}</div>
                      </div>
                      <p class:list={["font-regular is-card", { "w-dyn-bind-empty": !(item.shortDescription) }]}>{item.shortDescription}</p>
                      <a href={equipmentUrl(item)} class="blog-button w-inline-block">
                        <div class="blog-button-item">
