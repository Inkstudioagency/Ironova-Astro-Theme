---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byOrder, getProjects, getServices, img, projectUrl, serviceUrl } from "../lib/strapi";

const projects = await getProjects();
const services = await getServices();
const list0 = byOrder(services, "desc").slice(0, 1);
const list1 = byOrder(services, "desc").slice(1, 2);
const list2 = byOrder(services, "desc").slice(2, 3);
const list3 = byOrder(services, "desc").slice(3, 4);
const list4 = byOrder(projects).slice(0, 1);
const list5 = byOrder(projects).slice(1, 2);
const list6 = byOrder(projects).slice(2, 3);
---

