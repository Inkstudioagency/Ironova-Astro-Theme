                      {list1.map((item) => (
                        <div role="listitem" class="w-dyn-item">
                        <div to-top-2="" class="case-card">
                          <div class="case-card-media">
                            <a href={projectUrl(item)} class="project-image-wrapper w-inline-block"><img {...img(item.mainImage, "")} width="2160" height="1560" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(item.mainImage) }]}></a>
