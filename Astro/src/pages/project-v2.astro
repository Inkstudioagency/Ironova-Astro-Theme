                            </div>
                            <div class="project-button-wrap">
                              <a href={projectUrl(item)} class="blog-button w-inline-block">
                                <div class="blog-button-item">
                                  <div>View Project</div>
                                  <div class="button-arrow"><svg fill="none" viewBox="0 0 24 24" width="100%" xmlns="http://www.w3.org/2000/svg" class="arrow-icon-small">
                                      <path fill="currentColor" d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z"></path>
