                  <div>Construction</div>
                </a>
              </div>
              <div class="project-tab-content-v2 w-tab-content">
                <div data-w-tab="Tab 1" class="w-tab-pane w--tab-active">
                  <div class="w-dyn-list">
                    {list0.length > 0 ? (
                      <div role="list" class="case-grid w-dyn-items">
                      {list0.map((item) => (
                        <div role="listitem" class="w-dyn-item">
                        <div to-top-2="" class="case-card">
                          <div class="case-card-media">
                            <a parallax="" href={projectUrl(item)} class="project-image-wrapper w-inline-block"><img {...img(item.mainImage, "")} width="2160" height="1560" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(item.mainImage) }]}></a>
                            <div class="project-tag">
                              <div class:list={["font-small is-white", { "w-dyn-bind-empty": !(item.category) }]}>{item.category}</div>
                            </div>
                          </div>
                          <div class="case-card-body">
                            <div class="case-text">
                              <div class:list={["font-medium is-large", { "w-dyn-bind-empty": !(item.name) }]}>{item.name}</div>
                              <p class:list={["font-regular", { "w-dyn-bind-empty": !(item.shortDescription) }]}>{item.shortDescription}</p>
                            </div>
                            <div class="tag-list">
                              <div class="timeline-tag">
                                <div class:list={["font-regular is-tag", { "w-dyn-bind-empty": !(item.scopeItems[0]?.label) }]}>{item.scopeItems[0]?.label}</div>
                              </div>
                              <div class="timeline-tag">
                                <div class:list={["font-regular is-tag", { "w-dyn-bind-empty": !(item.scopeItems[1]?.label) }]}>{item.scopeItems[1]?.label}</div>
