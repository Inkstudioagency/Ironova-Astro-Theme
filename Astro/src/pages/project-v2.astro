---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byOrder, getProjects, img, projectUrl } from "../lib/strapi";

const projects = await getProjects();
const list0 = byOrder(projects);
const list1 = byOrder(projects, "asc").filter((p) => p.category === "Logistics");
const list2 = byOrder(projects, "desc").filter((p) => p.category === "Manufacturing");
const list3 = byOrder(projects, "asc").filter((p) => p.category === "Construction");
---

<BaseLayout pageId="6b03d34cb4fd67e674c0206e" title="Project V2 - Ironova" description="Discover industrial equipment projects focused on equipment selection, production workflows, engineering planning, and practical operational improvements.">
  <div class="page-wrapper">
    <Navbar variant="without-border" instance="79ccd801-b02a-c669-51d5-fb9c83b6fe28" />
    <main class="main">
      <section class="section is-black">
        <div class="container">
          <div class="hero-split">
            <div class="hero-split-text project-v2">
              <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;64e5f618-8d0f-ada4-b5d5-d00398ac6c4e&quot;],[]]]" class="breadcrumb">
                <a href="/" class="font-extra-small is-soft is-link">Home</a>
                <div class="font-extra-small is-soft">/</div>
                <div class="font-extra-small">Projects</div>
              </div>
              <div class="hero-split-body">
                <h1 data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;64e5f618-8d0f-ada4-b5d5-d00398ac6c50&quot;],[]]]" class="section-heading is-large">Practical Solutions. Measurable Project Goals.</h1>
                <p data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;64e5f618-8d0f-ada4-b5d5-d00398ac6c52&quot;],[]]]" class="font-normal is-lead">Explore how an equipment or engineering solution can be planned around a real operational challenge.</p>
                <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;64e5f618-8d0f-ada4-b5d5-d00398ac6c53&quot;],[]]]" class="hero-button-wrap">
                  <a href="/contact-v1" data-wf--primary-button--variant="base" data-wf-component-id="fe6f4be6-50ca-05e1-38e9-9a6e9da8d773" data-wf-variant-state="base" class="primary-button w-inline-block">
                    <div class="button-text-wrap">
                      <div class="footer-link-text is-one">Discuss Your Project</div>
                      <div class="footer-link-text is-two">Discuss Your Project</div>
                    </div>
                    <div class="button-arrow-wrap"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="100%" class="button-icon">
                        <path fill="currentColor" d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z"></path>
                      </svg><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" width="100%" class="button-icon">
                        <path fill="currentColor" d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z"></path>
                      </svg></div>
                  </a>
                </div>
              </div>
            </div>
            <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;64e5f618-8d0f-ada4-b5d5-d00398ac6c57&quot;],[]]]" class="hero-split-media"><img class="cover-image" src="/images/Hero-Image-1.webp" width="1980" height="1860" alt="Robotic arms working on an automated industrial production line" sizes="(max-width: 1980px) 100vw, 1980px" parallax="" srcset="/images/Hero-Image-1-p-500.webp 500w, /images/Hero-Image-1-p-800.webp 800w, /images/Hero-Image-1-p-1080.webp 1080w, /images/Hero-Image-1-p-1600.webp 1600w, /images/Hero-Image-1.webp 1980w"></div>
          </div>
        </div>
      </section>
      <section class="section is-black">
        <div class="section-gap is-large">
          <div class="container">
            <div class="page-section-head project-v2">
              <div to-top-0="" class="font-extra-small">Work in Action</div>
              <h2 heading-rebuild="" data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206e&quot;,&quot;5d00cbda-6cbb-70bc-ac1c-247c0d37d19d&quot;],[]]]" class="section-heading">Selected Case Studies.</h2>
            </div>
