---
/** CMS template page: one page per Strapi `service` entry. */
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaSection from "../../components/CtaSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getServices, img } from "../../lib/strapi";

export async function getStaticPaths() {
  const entries = await getServices();
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

// Resolve the entry at render time (not via getStaticPaths props) so content
// edits made in Strapi show up immediately while running `astro dev`.
const entry = (await getServices()).find((e) => e.slug === Astro.params.slug);
if (!entry) return Astro.redirect("/404");

