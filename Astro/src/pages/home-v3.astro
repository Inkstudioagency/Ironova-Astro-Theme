---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byOrder, getProjects, getServices, img, projectUrl, serviceUrl } from "../lib/strapi";

const projects = await getProjects();
const services = await getServices();
const list0 = byOrder(services).slice(0, 4);
const list1 = byOrder(projects, "desc").slice(0, 1);
const list2 = byOrder(projects, "desc").slice(1, 3);
