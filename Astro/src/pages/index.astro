---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogUrl, byNumber, byOrder, byPublishDate, getBlogPosts, getProjects, getServices, img, projectUrl, serviceUrl } from "../lib/strapi";

const posts = await getBlogPosts();
const projects = await getProjects();
const services = await getServices();
const list0 = byNumber(services).slice(0, 4);
const list1 = byOrder(projects).filter((p) => p.featured).slice(0, 1);
const list2 = byPublishDate(posts).slice(0, 2);
