<BaseLayout pageId="6b03d34cb4fd67e674c0206f" title="Project V3 - Ironova" description="Browse industrial project case studies across logistics, manufacturing, and construction, featuring equipment planning and engineering solutions.">
  <div class="page-wrapper">
    <Navbar variant="without-border" instance="412cd497-012c-bf7b-f764-0f8ec9d76726" />
    <main class="main">
      <section class="section project">
        <div class="project-cover-media"><img class="cover-image" src="/images/Hero-Image-3.webp" width="2880" height="1520" alt="Robotic arms working on an automated industrial production line" sizes="(max-width: 2880px) 100vw, 2880px" parallax="" srcset="/images/Hero-Image-3-p-500.webp 500w, /images/Hero-Image-3-p-800.webp 800w, /images/Hero-Image-3-p-1080.webp 1080w, /images/Hero-Image-3-p-1600.webp 1600w, /images/Hero-Image-3-p-2000.webp 2000w, /images/Hero-Image-3.webp 2880w"></div>
        <div class="project-cover-shade"></div>
        <div class="project-cover-fade"></div>
        <div class="project-cover-content">
          <div class="container is-cover">
            <div class="hero-three-head">
              <div class="hero-three-title">
                <h1 data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206f&quot;,&quot;62df265e-fe81-291c-bb98-3d8ec0725455&quot;],[]]]" class="section-heading is-large is-cover">Practical Solutions. Measurable Project Goals.</h1>
