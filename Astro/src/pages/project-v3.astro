---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byOrder, getProjects, img, projectUrl } from "../lib/strapi";

const projects = await getProjects();
const list0 = byOrder(projects);
const list1 = byOrder(projects, "asc").filter((p) => p.category === "Logistics");
const list2 = byOrder(projects, "desc").filter((p) => p.category === "Manufacturing");
const list3 = byOrder(projects, "asc").filter((p) => p.category === "Construction");
