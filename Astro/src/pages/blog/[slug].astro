---
/** CMS template page: one page per Strapi `blog` entry. */
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaSection from "../../components/CtaSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogUrl, byPublishDate, formatDate, getBlogPosts, img, richText } from "../../lib/strapi";

export async function getStaticPaths() {
  const entries = await getBlogPosts();
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

// Resolve the entry at render time (not via getStaticPaths props) so content
// edits made in Strapi show up immediately while running `astro dev`.
const entry = (await getBlogPosts()).find((e) => e.slug === Astro.params.slug);
if (!entry) return Astro.redirect("/404");

const posts = await getBlogPosts();
const list0 = byPublishDate(posts).filter((p) => p.slug !== entry.slug).slice(1, 4);
---

<BaseLayout pageId="6b03d34cb4fd67e674c02067" title={entry.seo?.metaTitle || `${entry.title} - Ironova`} description={entry.seo?.metaDescription || entry.shortDescription} image={img(entry.mainImage).src || undefined} type="article">
  <div class="page-wrapper">
    <Navbar variant="base" instance="97b0168b-236b-8e49-4b42-b60c9b186a58" />
    <main class="main">
      <section class="section is-black">
        <div class="container">
          <div class="project-hero is-blog">
            <div class="project-hero-top">
              <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6e9&quot;],[]]]" class="breadcrumb">
                <a href="/" class="font-extra-small is-soft is-link">Home</a>
                <div class="font-extra-small is-soft">/</div>
                <a href="/blog" class="font-extra-small is-soft is-link">Insights</a>
                <div class="font-extra-small is-soft">/</div>
                <div class="font-extra-small">Insights details</div>
              </div>
              <div class="blog-detail-head">
                <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6eb&quot;],[]]]" class:list={["font-extra-small", { "w-dyn-bind-empty": !(entry.category) }]}>{entry.category}</div>
                <h1 data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6ed&quot;],[]]]" class:list={["section-heading is-large is-blog", { "w-dyn-bind-empty": !(entry.title) }]}>{entry.title}</h1>
                <p data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6ef&quot;],[]]]" class:list={["font-normal is-blog", { "w-dyn-bind-empty": !(entry.shortDescription) }]}>{entry.shortDescription}</p>
                <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6f5&quot;],[]]]" class="blog-meta">
                  <p class:list={["categroy-text is-small", { "w-dyn-bind-empty": !(entry.readTime) }]}>{entry.readTime}</p>
                  <div class="blog-meta-dot"></div>
                  <p class:list={["categroy-text is-small", { "w-dyn-bind-empty": !(formatDate(entry.publishDate)) }]}>{formatDate(entry.publishDate)}</p>
                </div>
              </div>
            </div>
            <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;4d9afbda-d365-967e-2a64-aa4a3272e6fa&quot;],[]]]" class="project-hero-media"><img {...img(entry.mainImage, "")} loading="lazy" width="1707" height="1173" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(entry.mainImage) }]}></div>
          </div>
        </div>
      </section>
      <section class="section is-night-dark">
        <div class="section-gap is-large">
          <div class="container">
            <div class="blog-detail-layout">
              <div class="blog-toc">
                <div class="blog-toc-label">
                  <p class="categroy-text is-small">Table of Contents</p>
                </div>
                <a href="#section-1" class="blog-toc-link w-inline-block">
                  <div class:list={["", { "w-dyn-bind-empty": !(entry.sections[0]?.tocTitle) }]}>{entry.sections[0]?.tocTitle}</div>
                  <div class="demo">#</div>
                </a>
                <a href="#section-2" class="blog-toc-link w-inline-block">
                  <div class:list={["font-normal is-toc", { "w-dyn-bind-empty": !(entry.sections[1]?.tocTitle) }]}>{entry.sections[1]?.tocTitle}</div>
                  <div class="demo">#</div>
                </a>
                <a href="#section-3" class="blog-toc-link w-inline-block">
                  <div class:list={["font-normal is-toc", { "w-dyn-bind-empty": !(entry.sections[2]?.tocTitle) }]}>{entry.sections[2]?.tocTitle}</div>
                  <div class="demo">#</div>
                </a>
                <a href="#section-4" class="blog-toc-link w-inline-block">
                  <div class:list={["font-normal is-toc", { "w-dyn-bind-empty": !(entry.sections[3]?.tocTitle) }]}>{entry.sections[3]?.tocTitle}</div>
                  <div class="demo">#</div>
                </a>
              </div>
              <div class="blog-detail-content">
                <div class="blog-detail-block">
                  <div class="blog-detail-group">
                    <div to-top-0="" class="font-medium">
                      <div class:list={["detail-intro-span", { "w-dyn-bind-empty": !(entry.introText) }]}>{entry.introText}</div>
                    </div>
                    <p to-top-2="" class:list={["font-normal", { "w-dyn-bind-empty": !(entry.introParagraph) }]}>{entry.introParagraph}</p>
                  </div>
                </div>
                <div id="section-1" class="blog-detail-block">
                  <div to-top-0="" class:list={["blog-rich-text w-richtext", { "w-dyn-bind-empty": !(entry.sections[0]?.content) }]} set:html={richText(entry.sections[0]?.content)}></div>
                </div>
                <div id="section-2" class="blog-detail-block">
                  <div to-top-0="" class:list={["blog-rich-text w-richtext", { "w-dyn-bind-empty": !(entry.sections[1]?.content) }]} set:html={richText(entry.sections[1]?.content)}></div>
                </div>
                <div to-top-0="" class="blog-detail-media"><img {...img(entry.contentImage, "")} loading="lazy" width="1707" height="1173" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(entry.contentImage) }]}></div>
                <div id="section-3" class="blog-detail-block">
                  <div to-top-0="" class:list={["blog-rich-text w-richtext", { "w-dyn-bind-empty": !(entry.sections[2]?.content) }]} set:html={richText(entry.sections[2]?.content)}></div>
                </div>
                <div id="section-4" class="blog-detail-block">
                  <div to-top-0="" class:list={["blog-rich-text w-richtext", { "w-dyn-bind-empty": !(entry.sections[3]?.content) }]} set:html={richText(entry.sections[3]?.content)}></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section is-black">
        <div class="section-gap is-large">
          <div class="container">
            <div class="related-projects is-blog">
              <div class="section-head">
                <h2 heading-rebuild="" data-wf-target="[[[&quot;6b03d34cb4fd67e674c02067&quot;,&quot;67854a9e-23a8-cd4e-bdce-21fe5efb2b19&quot;],[]]]" class="section-heading">Related Articles</h2>
                <a to-top-4="" href="/blog" class="blog-button w-inline-block">
                  <div class="blog-button-item">
                    <div>View All Blog</div>
                    <div class="button-arrow"><svg fill="none" viewBox="0 0 24 24" width="100%" xmlns="http://www.w3.org/2000/svg" class="arrow-icon-small arrow-icon-small">
                        <path fill="currentColor" d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z"></path>
                      </svg><svg fill="none" viewBox="0 0 24 24" width="100%" xmlns="http://www.w3.org/2000/svg" class="arrow-icon-small arrow-icon-small">
                        <path fill="currentColor" d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z"></path>
                      </svg></div>
                  </div>
                  <div class="button-animated-line"></div>
                </a>
              </div>
              <div class="w-dyn-list">
                {list0.length > 0 ? (
                  <div role="list" class="blog-list w-dyn-items">
                  {list0.map((item) => (
                    <div role="listitem" class="w-dyn-item">
                    <div to-top-2="" class="blog-card">
                      <a href={blogUrl(item)} class="blog-image-link blog w-inline-block"><img {...img(item.mainImage, "")} loading="lazy" width="1707" height="1173" parallax="" class:list={["cover-image", { "w-dyn-bind-empty": !(item.mainImage) }]}>
                        <div class="blog-image-overlay">
                          <div class="blog-read-tag">
                            <p class="font-regular is-medium is-upper">Read article</p><svg xmlns="http://www.w3.org/2000/svg" height="24" width="24" viewBox="0 0 24 24" fill="none" class="slider-arrow-icon slider-arrow-icon">
                              <path d="M4 11H16V13H4V11ZM14 7H16V9H14V7ZM16 9H18V11H16V9ZM18 11H20V13H18V11ZM16 13H18V15H16V13ZM14 15H16V17H14V15Z" fill="currentColor"></path>
                            </svg>
                          </div>
                        </div>
                      </a>
                      <div class="blog-card-content">
                        <div class="blog-meta">
                          <p class:list={["font-extra-small is-brand", { "w-dyn-bind-empty": !(item.category) }]}>{item.category}</p>
                          <div class="blog-meta-dot"></div>
                          <p class:list={["font-extra-small", { "w-dyn-bind-empty": !(item.readTime) }]}>{item.readTime}</p>
                        </div>
                        <a href={blogUrl(item)} class="blog-title-link w-inline-block">
                          <div class:list={["font-medium is-faq", { "w-dyn-bind-empty": !(item.title) }]}>{item.title}</div>
                          <div class="demo">#</div>
                        </a>
                      </div>
                    </div>
                  </div>
                    ))}
                </div>
                  ) : (
                <div class="w-dyn-empty">
                  <div>No items found.</div>
                </div>
                  )}
              </div>
            </div>
          </div>
        </div>
      </section>
      <CtaSection pageId="6b03d34cb4fd67e674c02067" instance="c024259f-46e7-b04f-c7da-8088120f36e9" />
    </main>
    <Footer />
  </div>
</BaseLayout>
