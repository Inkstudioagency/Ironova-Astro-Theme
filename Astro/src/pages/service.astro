---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaSection from "../components/CtaSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byNumber, getServices, img, serviceUrl } from "../lib/strapi";

const services = await getServices();
const list0 = byNumber(services);
---

<BaseLayout pageId="6b03d34cb4fd67e674c0206c" title="Service - Ironova" description="Explore industrial engineering services from Ironova, including equipment design, manufacturing, installation, commissioning, maintenance, and integration.">
  <div class="page-wrapper">
    <Navbar variant="without-border" instance="178c9be8-45b0-0c93-8d42-9d0c72a745a6" />
    <main class="main">
      <section class="section is-black">
        <div class="container">
          <div class="hero-three-layout is-page">
            <div class="page-hero-top">
              <div data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206c&quot;,&quot;65ac4f4a-1a82-f8f3-9991-4884ee86bfe7&quot;],[]]]" class="breadcrumb">
                <a href="/" class="font-extra-small is-soft is-link">Home</a>
                <div class="font-extra-small is-soft">/</div>
                <div class="font-extra-small">Services</div>
              </div>
              <div class="hero-three-head service">
                <div class="hero-three-title">
                  <h1 data-wf-target="[[[&quot;6b03d34cb4fd67e674c0206c&quot;,&quot;65ac4f4a-1a82-f8f3-9991-4884ee86bfe9&quot;],[]]]" class="section-heading is-large is-page">Practical Expertise for Every Stage of Your Operation.</h1>
