---
/** CMS template page: one page per Strapi `project` entry. */
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CtaSection from "../../components/CtaSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byOrder, getProjects, img, projectUrl } from "../../lib/strapi";

export async function getStaticPaths() {
  const entries = await getProjects();
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

// Resolve the entry at render time (not via getStaticPaths props) so content
// edits made in Strapi show up immediately while running `astro dev`.
const entry = (await getProjects()).find((e) => e.slug === Astro.params.slug);
if (!entry) return Astro.redirect("/404");

const projects = await getProjects();
const list0 = byOrder(projects).filter((p) => p.slug !== entry.slug).slice(0, 2);
