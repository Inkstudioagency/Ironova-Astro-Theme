---
/**
 * Base document layout shared by every page.
 *
 * Loads the original Webflow stylesheets and runtime (webflow.js, GSAP, Lenis) so
 * all interactions behave exactly like the source template. `pageId` must be the
 * Webflow page id of the original page: webflow.js uses it to attach that page's
 * IX3 interactions.
 */
import SeoMeta from "../components/SeoMeta.astro";
import config from "../config/config.json";

interface Props {
  pageId: string;
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { pageId, ...seo } = Astro.props;
---

